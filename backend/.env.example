# SnackSwap Comics Configuration

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
FREEPIK_API_KEY=your_freepik_api_key_here

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=optional_api_key

# Storage
STORAGE_BACKEND=local  # local, s3, gcs
STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=snackswap-comics
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# Database (optional for session storage)
DATABASE_URL=sqlite:///./snackswap.db

# Application Settings
DEBUG=true
ENABLE_MAPS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
CONTENT_RETENTION_DAYS=30

# Model Configuration
GEMINI_VISION_MODEL=gemini-2.0-flash-exp
GEMINI_WRITER_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# Feature Flags
ENABLE_ADMIN_APPROVAL=false
ENABLE_MAPS_SWAPS=false
ENABLE_ANALYTICS=false
