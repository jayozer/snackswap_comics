# SnackSwap Comics Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================

# Google Gemini API Key (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Freepik API Key (OPTIONAL - enables professional comic assets)
# Get yours at: https://www.freepik.com/api
# Features: Professional speech bubbles, comic frames, backgrounds
# If not set, comics use PIL-rendered bubbles (still works, just simpler)
FREEPIK_API_KEY=your_freepik_api_key_here

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# This project uses Qdrant Cloud by default (always available, no Docker needed)

# Qdrant Cloud (DEFAULT - recommended)
# 1. Sign up at: https://cloud.qdrant.io
# 2. Create a cluster (free tier: 1GB storage)
# 3. Go to: Clusters → Your Cluster → "Get API Key"
# 4. Copy the cluster URL and API key below
QDRANT_URL=https://YOUR-CLUSTER-ID.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Alternative: Local Docker (for offline development)
# Run: docker run -p 6333:6333 qdrant/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# After configuring, seed the database:
# cd backend && python -m data.seeds.seed_data

# Storage
STORAGE_BACKEND=local  # local, s3, gcs
STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=snackswap-comics
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# Database (optional for session storage)
DATABASE_URL=sqlite:///./snackswap.db

# Application Settings
DEBUG=true
ENABLE_MAPS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
CONTENT_RETENTION_DAYS=30

# Model Configuration
# Vision: gemini-2.5-pro for fast image analysis
GEMINI_VISION_MODEL=gemini-3-pro-preview
# Writer: gemini-2.5-pro for higher quality comic scripts
GEMINI_WRITER_MODEL=gemini-2.5-flash-preview-09-2025
# Image: Nano-banana for 2K resolution comic generation
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# Thinking Mode Configuration
# Vision thinking level: NONE, LOW, MEDIUM, HIGH
GEMINI_VISION_THINKING_LEVEL=HIGH
# Writer thinking budget (max 24576 tokens)
GEMINI_WRITER_THINKING_BUDGET=24576

# Feature Flags
ENABLE_ADMIN_APPROVAL=false
ENABLE_MAPS_SWAPS=false
ENABLE_ANALYTICS=false
